{
  "id": "vet-inventory",
  "version": "0.2.0",
  "apiVersion": "2.0",
  "displayName": "Inventario Veterinario",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "settings": {
      "groups": [{ "id": "products", "label": "Inventario", "order": 60 }],
      "pages": [
        {
          "id": "vet-inventory.insumos",
          "group": "products",
          "label": "Stock insumos",
          "icon": "Package",
          "order": 30
        }
      ],
      "sections": [
        {
          "id": "vet-inventory.insumos.stock",
          "page": "vet-inventory.insumos",
          "label": "General",
          "order": 10,
          "items": [
            {
              "key": "vet-inventory.insumos.defaultMinimum",
              "type": "number",
              "label": "Stock mínimo por defecto",
              "description": "Nivel por debajo del cual un insumo se marca \"bajo mínimo\" en Inventario. Se aplica a todos los insumos que no tengan un mínimo propio. 0 = sin aviso.",
              "default": 5,
              "min": 0,
              "tags": ["insumo", "stock", "minimo", "aviso"]
            }
          ]
        }
      ]
    },
    "menus": [
      {
        "path": "Inventario",
        "order": 10,
        "viewId": "vet-inventory.inventario.open",
        "icon": "Boxes"
      },
      {
        "path": "Insumos",
        "order": 20,
        "viewId": "vet-inventory.insumos.open",
        "icon": "Package"
      }
    ],
    "views": [
      {
        "id": "vet-inventory.inventario.open",
        "title": "Inventario",
        "component": "./dist/views/inventario/index.js",
        "export": "InventarioView"
      },
      {
        "id": "vet-inventory.lotes.open",
        "title": "Lotes y stock",
        "component": "./dist/views/lotes/index.js",
        "export": "LotesView"
      },
      {
        "id": "vet-inventory.ingreso-manual.open",
        "title": "Ingreso manual",
        "component": "./dist/views/ingreso-manual/index.js",
        "export": "IngresoManualView"
      },
      {
        "id": "vet-inventory.ajustar-stock.open",
        "title": "Dar de baja",
        "component": "./dist/views/ajustar-stock/index.js",
        "export": "AjustarStockView"
      },
      {
        "id": "vet-inventory.insumos.open",
        "title": "Insumos",
        "component": "./dist/views/insumos/index.js",
        "export": "InsumosView"
      },
      {
        "id": "vet-inventory.editar-insumo.open",
        "title": "Editar insumo",
        "component": "./dist/views/editar-insumo/index.js",
        "export": "EditarInsumoView"
      },
      {
        "id": "vet-inventory.insumo-detalle.open",
        "title": "Detalle de insumo",
        "component": "./dist/views/insumo-detalle/index.js",
        "export": "InsumoDetalleView"
      },
      {
        "id": "vet-inventory.nuevo-insumo.open",
        "title": "Nuevo insumo",
        "component": "./dist/views/nuevo-insumo/index.js",
        "export": "NuevoInsumoView"
      }
    ],
    "repositories": []
  },
  "initView": null
}
